rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Documentos de verificación (cédula, matrícula, selfie) que sube cada
    // solicitante durante el registro de personal operativo. Solo el dueño y
    // un admin pueden leerlos — nadie más, ya que son documentos de identidad.
    // Comprobantes de transferencia que sube el cliente al confirmar un
    // pedido. Solo el dueño y un admin (que los verifica) pueden verlos.
    match /receipts/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /solicitudes/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
